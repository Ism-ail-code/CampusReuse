# ---------------------------------------------------------------------------
# Supabase configuration (copy to .env.local and fill in)
# ---------------------------------------------------------------------------
# Create a free project at https://supabase.com -> Project Settings -> API
#
# If these are left empty, the app starts in DEMO MODE with sample data so
# you can explore every flow without a backend. A clear banner is shown.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
